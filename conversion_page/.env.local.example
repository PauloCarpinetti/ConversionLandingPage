# Google Analytics 4 Measurement ID (formato "G-XXXXXXXXXX").
# Sem esta variável, o <GoogleAnalytics> não é montado (ver app/layout.tsx) e
# a página continua funcionando normalmente, apenas sem rastreamento (FR-011).
NEXT_PUBLIC_GA_ID=

# Número de WhatsApp da clínica em formato E.164 sem símbolos (ex.: 5511999999999).
# Sem esta variável, o CTA flutuante não é renderizado (ver components/ui/whatsapp-cta.tsx).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL final de produção (ex.: https://clinica.vercel.app), sem barra no final.
# Usada para resolver a URL absoluta da imagem de Open Graph (app/opengraph-image.tsx).
# Sem esta variável, cai em http://localhost:3000 — funciona em dev, mas quebra
# o og:image quando compartilhado a partir do deploy real (ver app/layout.tsx).
NEXT_PUBLIC_SITE_URL=
